NODE_ENV=development
LOG_LEVEL=info
BOT_PREFIX=!
BOT_OWNER_ID=
BOT_VERSION=0.1 beta

DATABASE_PATH=./data/anya.db
TEMP_DIRECTORY=./temp
SESSION_NAME=anya-session

MAX_CONCURRENT_MEDIA_JOBS=2
AUTO_READ=true

AI_REPLY_FALLBACK2_ENABLED=true
AI_REPLY_FALLBACK2_BASE_URL=https://tokenharbor.ai/v1
AI_REPLY_FALLBACK2_API_KEY=
AI_REPLY_FALLBACK2_MODEL=deepseek-v4.1-flash:free

AI_REPLY_FALLBACK_ENABLED=true
AI_REPLY_FALLBACK_BASE_URL=https://codecraftapi.com/v1
AI_REPLY_FALLBACK_API_KEY=
AI_REPLY_FALLBACK_MODEL=deepseek-v4-pro-0813
