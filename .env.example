# Konfigurasi Lingkungan Anya Bot
NODE_ENV=development
LOG_LEVEL=info
BOT_PREFIX=!
BOT_OWNER_ID=

# Jalur Penyimpanan
DATABASE_PATH=./data/anya.db
TEMP_DIRECTORY=./temp
SESSION_NAME=anya-session

# Batas Konkurensi Pekerjaan Media
MAX_CONCURRENT_MEDIA_JOBS=2

# Layanan Pengunduh Eksternal (Diperlukan pada Phase 8)
DOWNLOADER_API_URL=
DOWNLOADER_API_KEY=
